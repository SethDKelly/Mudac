{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/worker/**/*.ts",
    "packages/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
