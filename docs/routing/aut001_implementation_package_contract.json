  "subphases": [
    {
      "id": "AUT-001-A",
      "title": "Control-Plane Substrate & Deterministic Replay Core",
      "purpose": "Create the isolated tooling substrate, append-only fact model, deterministic R-B lifecycle projection, R-C revision/evidence engine and executable Phase-021 replay/failure-injection harness.",
      "predecessors": [],
      "external_side_effects": false,
      "provider_role_preference": {"implementer":"CODEX","independent_reviewer":"CURSOR","adversarial_reviewer":"FRESH_SEPARATE_SESSION"}
    },
    {
      "id": "AUT-001-B",
      "title": "Live Read-Only Shadow & GitHub Reconciliation",
      "purpose": "Ingest/reconcile real GitHub events and repository truth without writes, compare projected lifecycle/next-action results against human coordination, and record explainable divergence.",
      "predecessors": ["AUT-001-A"],
      "github_writes": false,
      "agent_dispatch": false,
      "provider_role_preference": {"implementer":"CURSOR","independent_reviewer":"CODEX","adversarial_reviewer":"FRESH_SEPARATE_SESSION"}
    },
    {
      "id": "AUT-001-C",
      "title": "Dispatcher, Provider Adapters, Isolation & Provenance",
      "purpose": "Implement R-D dispatcher mechanics and bounded Cursor/Codex adapters with immutable dispatch/context/provenance manifests, role/session isolation and serialized-surface reservations.",
      "predecessors": ["AUT-001-A", "AUT-001-B"],
      "provider_role_preference": {"implementer":"CODEX","independent_reviewer":"CURSOR","adversarial_reviewer":"FRESH_SEPARATE_SESSION"},
      "provider_mechanics_must_be_qualified_before_use": true,
      "generic_shell_fallback_for_missing_provider_capability": false
    },
    {
      "id": "AUT-001-D",
      "title": "Development-Control MCP Query/Record & Authorization Boundary",
      "purpose": "Expose R-F QUERY and RECORD_COMPUTE capabilities with server-side schema validation, resource-bound authentication, authorization tuples, immutable audit envelopes and no side-effecting bounded actions enabled.",
      "predecessors": ["AUT-001-A", "AUT-001-C"],
      "bounded_actions_enabled": false,
      "provider_role_preference": {"implementer":"CURSOR","independent_reviewer":"CODEX","adversarial_reviewer":"FRESH_SEPARATE_SESSION"}
    },
    {
      "id": "AUT-001-E",
      "title": "Bounded Non-Human Side Effects",
      "purpose": "Enable only declared R-F bounded actions through operation IDs, optimistic preconditions, reconciliation, circuit breakers and stage-specific capability grants.",
      "predecessors": ["AUT-001-B", "AUT-001-C", "AUT-001-D"],
      "allowed_action_families": [
        "isolated_worktree_creation",
        "authorized_agent_dispatch",
        "draft_pr_open_or_coordination_update",
        "ready_or_draft_state_coordination_when_declared",
        "declared_dependency_branch_synchronization",
        "serialized_surface_reservation_and_release"
      ],
      "forbidden_action_families": [
        "protected_merge",
        "release",
        "production",
        "g2_creation",
        "scope_expansion",
        "next_phase_authority"
      ],
      "provider_role_preference": {"implementer":"CODEX","independent_reviewer":"CURSOR","adversarial_reviewer":"FRESH_SEPARATE_SESSION"}
    },
    {
      "id": "AUT-001-F",
      "title": "020-D Test-Control Evidence Bridge",
      "purpose": "Implement the declared-evidence-request and evidence-reference bridge without weakening 020-D authorization, environment isolation or production denial and without direct lifecycle advancement.",
      "predecessors": ["AUT-001-D", "AUT-001-E", "DEP-020D-RUNTIME"],
      "live_execution_condition": "020D_RUNTIME_OPERATIONALLY_ACCEPTED_AND_SEPARATELY_AUTHORIZED",
      "production": false,
      "provider_role_preference": {"implementer":"CURSOR","independent_reviewer":"CODEX","adversarial_reviewer":"FRESH_SEPARATE_SESSION"}
    },
    {
      "id": "AUT-001-G",
      "title": "Independent Exit, Shadow Qualification & Enablement Recommendation",
      "purpose": "Run exact-revision verification, executable historical replay, failure injection, security review, fresh independent/adversarial review, shadow-divergence review and G5; recommend but do not self-authorize operational use.",
      "predecessors": ["AUT-001-A", "AUT-001-B", "AUT-001-C", "AUT-001-D", "AUT-001-E"],
      "full_composed_profile_additional_predecessor": "AUT-001-F",
      "may_enable_itself": false,
      "may_authorize_phase022": false
    }
  ],
  "work_unit_graph": {
    "default_execution": "SEQUENTIAL_BY_SUBPHASE",
