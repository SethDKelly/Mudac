  ],
  "primary_transitions": [
    {"from": "PLANNING_READY", "event": "start_gate.ready", "to": "START_GATE_READY"},
    {"from": "START_GATE_READY", "event": "start_gate.pass", "to": "AWAITING_G2"},
    {"from": "AWAITING_G2", "event": "authority.g2_granted", "to": "G2_AUTHORIZED", "human_stop": true},
    {"from": "G2_AUTHORIZED", "event": "workspace.provision_requested", "to": "WORKSPACE_PROVISIONING"},
    {"from": "WORKSPACE_PROVISIONING", "event": "workspace.provisioned", "to": "IMPLEMENTING"},
    {"from": "IMPLEMENTING", "event": "candidate.registered", "to": "CANDIDATE_REGISTERED"},
    {"from": "CANDIDATE_REGISTERED", "event": "verification.started", "to": "VERIFYING"},
    {"from": "VERIFYING", "event": "verification.pass", "to": "AWAITING_INDEPENDENT_REVIEW"},
    {"from": "AWAITING_INDEPENDENT_REVIEW", "event": "review.independent.pass", "to": "AWAITING_ADVERSARIAL_REVIEW"},
    {"from": "AWAITING_ADVERSARIAL_REVIEW", "event": "review.adversarial.pass", "to": "AWAITING_PR_CI"},
    {"from": "AWAITING_PR_CI", "event": "github.check.required_set_pass", "to": "AWAITING_G5"},
    {"from": "AWAITING_G5", "event": "gate.g5.pass", "to": "AWAITING_HUMAN_MERGE"},
    {"from": "AWAITING_HUMAN_MERGE", "event": "github.pull_request.merged_after_human_approval", "to": "INTEGRATION_VERIFYING", "human_stop": true},
    {"from": "INTEGRATION_VERIFYING", "event": "integration.pass", "to": "AWAITING_CLOSURE_MERGE"},
    {"from": "AWAITING_CLOSURE_MERGE", "event": "closure.merged_after_human_approval", "to": "COMPLETE", "human_stop": true}
  ],
  "repair_transitions": [
    {"from": ["VERIFYING", "AWAITING_INDEPENDENT_REVIEW", "AWAITING_ADVERSARIAL_REVIEW", "AWAITING_PR_CI"], "event": "blocking_failure_within_existing_g2", "to": "REPAIR_REQUIRED"},
    {"from": "REPAIR_REQUIRED", "event": "repair.authorized_within_scope_and_budget", "to": "IMPLEMENTING"},
    {"from": "REPAIR_REQUIRED", "event": "scope_or_budget_expansion_required", "to": "BLOCKED"}
