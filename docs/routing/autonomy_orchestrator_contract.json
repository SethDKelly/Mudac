  "human_authority_transitions": [
    {"from": "AWAITING_G2", "to": "G2_AUTHORIZED", "authority": "EXPLICIT_HUMAN_PROGRAM_G2"},
    {"from": "REPAIR_REQUIRED", "to": "IMPLEMENTING", "condition": "scope_or_budget_expansion", "authority": "EXPLICIT_HUMAN_OR_GATEKEEPER_DISPOSITION_AND_REAUTH_IF_REQUIRED"},
    {"from": "AWAITING_HUMAN_MERGE", "to": "INTEGRATION_VERIFYING", "authority": "HUMAN_PROTECTED_MERGE_DECISION_PLUS_OBSERVED_MERGE"},
